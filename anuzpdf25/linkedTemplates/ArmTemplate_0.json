						"userProperties": [],
						"typeProperties": {
							"variableName": "formatedDate",
							"value": {
								"value": "@formatDateTime(variables('currdate'),'ddMMyyyy')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "getFileName",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "getFormatedDate",
								"dependencyConditions": [
									"Succeeded"
