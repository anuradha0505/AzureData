							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "currdate",
							"value": {
								"value": "@utcNow()",
								"type": "Expression"
							}
						}
					},
					{
						"name": "getFormatedDate",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "getCurrentDatw",
								"dependencyConditions": [
									"Succeeded"
